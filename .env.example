# LLM provider: gemini | anthropic
ACE_PROVIDER=gemini

# Gemini Developer API key. GOOGLE_API_KEY is also supported by the SDK.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Defaults to gemini-2.5-flash for Gemini.
ACE_MODEL=gemini-2.5-flash

# Optional upload-classifier override. Useful when chat uses Anthropic.
GEMINI_CLASSIFICATION_MODEL=gemini-2.5-flash
